# ============================================================
# ICT Indicator repo - gitignore (MQL5 / MetaTrader 5)
# ============================================================

# --- Windows junk ---
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editor / IDE junk ---
*.bak
*.tmp
*.swp
*~
.vs/
.vscode/
.idea/

# --- MQL5 build artifacts (regenerated by Sync-And-Compile-Canonical.ps1) ---
*.ex5
*.ex4
*.ex~
*.mqh.orig
# metaeditor compile logs
*.log

# --- Runtime CSV evidence (indicator writes these; regenerate on reload) ---
# Kept out on purpose: they are per-account/per-time evidence, not source.
*.csv
!05_TESTS_AND_VALIDATION/*.fixture.csv
!05_TESTS_AND_VALIDATION/**/*.fixture.csv
!**/*.fixture.csv

# --- Local scratch / private notes ---
00_INBOX_NEW/private*
TODO_local*
notes_local*

# --- Large binaries should never be committed ---
*.zip
*.7z
*.rar
*.exe
*.dll

